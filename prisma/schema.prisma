generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum DoctorStatus {
  ACTIVE
  BLOCKED
}

enum RecordStatus {
  PENDING
  OPENED
  COMPLETED
}

enum Plan {
  NORMAL
  PREMIUM
  ADMIN
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      Role       @default(DOCTOR)
  plan      Plan       @default(NORMAL)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  templates Template[]
}

model DoctorProfile {
  id             String   @id @default(cuid())
  role           Role     @default(DOCTOR)
  
  // Authentication & Account
  email          String    @unique
  passwordHash   String    @default("")
  avatarUrl      String?
  logoUrl        String?

  fullName       String
  crm            String
  specialty      String
  language       String   @default("pt")
  
  // PDF Preferences
  signatureAlign String   @default("center") // "left", "center", "right"
  showLogoText   Boolean  @default(true)
  signatureImage String?
  
  // AI Settings
  aiModel        String   @default("gemini-1.5-flash") // "gemini-1.5-flash", "gemini-1.5-pro"
  
  // SaaS Admin Fields
  status                 DoctorStatus @default(ACTIVE)
  plan                   Plan     @default(NORMAL)
  isActive               Boolean  @default(true)
  expiresAt              DateTime?
  subscriptionValue      Decimal?
  subscriptionExpiresAt  DateTime?
  lastLoginAt            DateTime?
  createdById            String?
  deletedAt              DateTime?
  notificationsEnabled   Boolean  @default(true)
  
  updatedAt      DateTime @updatedAt

  PatientRecord  PatientRecord[]
  Template       Template[]
  Subscription   Subscription[]
  Office         Office[]
}

model Template {
  id          String   @id @default(cuid())
  name        String   // Ex: "Ortopedia - Primeira Consulta"
  description String?
  isDefault   Boolean  @default(false)
  
  // JSONB Field to store flexible schema of the template
  // Example: [{ id: "hda", label: "História", type: "textarea" }]
  schema      String
  
  // JSONB Field to store translations for the schema labels
  // Example: { "en": { "hda": "History" }, "es": { "hda": "Historia" } }
  translations String?
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  doctorId    String?
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  PatientRecord PatientRecord[]
}

model PatientRecord {
  id          String   @id @default(cuid())
  patientName String
  date        DateTime @default(now())
  
  // Storing the actual anamnesis data generated by AI matching the Template schema
  // Example: { hda: "Paciente refere dor no joelho...", medicacoes: "Dipirona" }
  data        String

  isRead      Boolean  @default(false)
  status      RecordStatus @default(PENDING) // PENDING (Amarelo), OPENED(Azul), COMPLETED (Verde)
  isActive    Boolean  @default(true)

  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  doctorId    String?
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modelos de Infraestrutura SaaS

model Subscription {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  plan      String   @default("FREE")
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime?
  updatedAt DateTime @updatedAt
}

model Office {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?  // Pode ser ID do DoctorProfile ou User
  entityId  String?
  details   String?  // JSON estruturado
  createdAt DateTime @default(now())
}

